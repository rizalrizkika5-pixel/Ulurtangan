rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        getUserData().role == 'SUPER_ADMIN' ||
        request.auth.token.email == 'ulurtangan@akun.yiut.invalid' ||
        request.auth.token.email == 'rizalrizkika5@gmail.com'
      );
    }

    function isLeaderOrAdmin() {
      return isSignedIn() && (
        isSuperAdmin() ||
        getUserData().role == 'PIMPINAN' ||
        getUserData().role == 'KOORDINATOR_OPERASIONAL'
      );
    }

    function isAccountActive() {
      return isSignedIn() && (getUserData().isActive == true || isSuperAdmin());
    }

    // User profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (isSuperAdmin() || request.auth.uid == userId);
      allow update: if isSignedIn() && (
        isSuperAdmin() || 
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isActive']))
      );
      allow delete: if isSuperAdmin();
    }

    // Tasks collection
    match /tasks/{taskId} {
      allow read: if isSignedIn() && isAccountActive();
      allow create: if isSignedIn() && isAccountActive();
      allow update: if isSignedIn() && isAccountActive() && (
        isLeaderOrAdmin() ||
        resource.data.picId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'progress', 'proofLinks', 'notes', 'obstacles', 'updatedAt'])
      );
      allow delete: if isSuperAdmin() || (isLeaderOrAdmin() && resource.data.createdById == request.auth.uid);
    }

    // Campaigns collection
    match /campaigns/{campaignId} {
      allow read: if isSignedIn() && isAccountActive();
      allow create: if isSignedIn() && isAccountActive() && (isLeaderOrAdmin() || getUserData().role == 'DIVISI_PROGRAM' || getUserData().role == 'DIVISI_FUNDRAISING');
      allow update: if isSignedIn() && isAccountActive() && (isLeaderOrAdmin() || getUserData().role == 'DIVISI_PROGRAM' || getUserData().role == 'DIVISI_FUNDRAISING');
      allow delete: if isSuperAdmin();
    }

    // Assessments
    match /assessments/{assessmentId} {
      allow read: if isSignedIn() && isAccountActive();
      allow create, update: if isSignedIn() && isAccountActive() && (isLeaderOrAdmin() || getUserData().role == 'DIVISI_PROGRAM');
      allow delete: if isSuperAdmin();
    }

    // Donors (CRM)
    match /donors/{donorId} {
      allow read: if isSignedIn() && isAccountActive() && (isLeaderOrAdmin() || getUserData().role == 'ADMIN_CRM' || getUserData().role == 'DIVISI_FUNDRAISING');
      allow create, update: if isSignedIn() && isAccountActive() && (isLeaderOrAdmin() || getUserData().role == 'ADMIN_CRM' || getUserData().role == 'DIVISI_FUNDRAISING');
      allow delete: if isSuperAdmin();
    }

    // Donations
    match /donations/{donationId} {
      allow read: if isSignedIn() && isAccountActive() && (isLeaderOrAdmin() || getUserData().role == 'ADMIN_CRM' || getUserData().role == 'DIVISI_FUNDRAISING');
      allow create: if isSignedIn() && isAccountActive() && (isLeaderOrAdmin() || getUserData().role == 'ADMIN_CRM' || getUserData().role == 'DIVISI_FUNDRAISING');
      allow update: if isSignedIn() && isAccountActive() && (isLeaderOrAdmin() || getUserData().role == 'ADMIN_CRM');
      allow delete: if isSuperAdmin();
    }

    // Budgets & Expenditures
    match /budgets/{budgetId} {
      allow read: if isSignedIn() && isAccountActive();
      allow create, update: if isSignedIn() && isAccountActive() && isLeaderOrAdmin();
      allow delete: if isSuperAdmin();
    }

    match /expenditures/{expenditureId} {
      allow read: if isSignedIn() && isAccountActive();
      allow create, update: if isSignedIn() && isAccountActive();
      allow delete: if isSuperAdmin();
    }

    // Implementations
    match /implementations/{implementationId} {
      allow read: if isSignedIn() && isAccountActive();
      allow create, update: if isSignedIn() && isAccountActive() && (isLeaderOrAdmin() || getUserData().role == 'DIVISI_PROGRAM');
      allow delete: if isSuperAdmin();
    }

    // Content Calendar
    match /contentCalendar/{contentId} {
      allow read: if isSignedIn() && isAccountActive();
      allow create, update: if isSignedIn() && isAccountActive() && (isLeaderOrAdmin() || getUserData().role == 'KONTEN_KREATOR_VIDEO' || getUserData().role == 'MEDIA_SOSIAL_WEBSITE');
      allow delete: if isSuperAdmin();
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (resource.data.recipientUid == request.auth.uid || isSuperAdmin());
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (resource.data.recipientUid == request.auth.uid || isSuperAdmin());
      allow delete: if isSignedIn() && (resource.data.recipientUid == request.auth.uid || isSuperAdmin());
    }

    // Meetings & Decisions
    match /meetings/{meetingId} {
      allow read: if isSignedIn() && isAccountActive();
      allow create, update: if isSignedIn() && isAccountActive() && isLeaderOrAdmin();
      allow delete: if isSuperAdmin();
    }

    match /decisions/{decisionId} {
      allow read: if isSignedIn() && isAccountActive();
      allow create, update: if isSignedIn() && isAccountActive() && isLeaderOrAdmin();
      allow delete: if isSuperAdmin();
    }

    // KPI
    match /kpi/{kpiId} {
      allow read: if isSignedIn() && isAccountActive() && (resource.data.userId == request.auth.uid || isLeaderOrAdmin());
      allow create, update: if isSignedIn() && isAccountActive() && isLeaderOrAdmin();
      allow delete: if isSuperAdmin();
    }

    // Audit logs (write only by auth users, no delete or modify)
    match /auditLogs/{logId} {
      allow read: if isSignedIn() && isLeaderOrAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }
  }
}
